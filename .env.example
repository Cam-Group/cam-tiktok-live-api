# Docker Compose settings. Native npm start does not automatically load this file.
# Copy to .env and replace the allowed origin before public deployment.
# For Render, use render.yaml and Dashboard environment settings; see docs/render.md.
PORT=3100
ALLOWED_ORIGINS=http://localhost:5173
MAX_CLIENTS=100
MAX_CLIENTS_PER_IP=5
REQUESTS_PER_MINUTE=60
GLOBAL_REQUESTS_PER_MINUTE=600

# Exact controlled immediate proxy IPs only; empty means ignore forwarded identity.
# The proxy must overwrite X-Forwarded-For with one verified client IP.
TRUSTED_PROXIES=
CLIENT_IP_HEADER=x-forwarded-for
# compose.cloudflare.yaml sets the exact loopback trust and cf-connecting-ip header.
